    "hoverOpacity": 0.08,
    "focusOpacity": 0.12,
    "pressedOpacity": 0.12,
    "focusRing": {
      "width": "0.1875rem",
      "color": "#6D28D9"
    }
  },
  "accessibility": {
    "minimumTouchTarget": "3rem",
    "focusVisible": true,
    "doNotUseColorAloneForErrors": true,
    "labelsRequiredForInputs": true
  }

  "elevation": {
    "level0": "none",
    "level1": "0 1px 2px rgba(0,0,0,0.08)",
    "level2": "0 2px 6px rgba(0,0,0,0.10)",
    "level3": "0 4px 12px rgba(0,0,0,0.12)"

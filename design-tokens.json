    "sm": "0.5rem",
    "md": "0.75rem",
    "lg": "1rem",
    "xl": "1.5rem",
    "xxl": "2rem",
    "xxxl": "3rem",
    "huge": "4rem"
  },
  "shape": {
    "none": "0",
    "extraSmall": "0.25rem",
    "small": "0.5rem",
    "medium": "0.75rem",
    "large": "1rem",
    "extraLarge": "1.75rem",
    "full": "9999px"

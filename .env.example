# .env.example — StudyFlow Assessment 1
#
# Copy this file to .env (or .env.local for Next.js) and fill in real values.
# NEVER commit .env or any file containing real credentials to Git.
# .env is listed in .gitignore and must remain excluded.

# -----------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------
# PostgreSQL connection string used by Prisma.
# Replace USER, PASSWORD, HOST, PORT, and DATABASE_NAME with real values.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/studyflow_auth"

# -----------------------------------------------------------------------
# Session Management
# -----------------------------------------------------------------------
# Custom server-side sessions stored in PostgreSQL via Prisma.
# The browser receives only an opaque random session identifier in an HttpOnly cookie.
SESSION_COOKIE_NAME="studyflow_session"

# -----------------------------------------------------------------------
# Email Delivery (Nodemailer / SMTP)
# -----------------------------------------------------------------------
# SMTP host for Nodemailer (e.g. mail.gandi.net, smtp.sendgrid.net, smtp4dev, MailHog).
# Leave SMTP_HOST empty in local development to log emails to the server console instead.
SMTP_HOST=""
SMTP_PORT=""
# Set to "true" when SMTP_PORT is 465 (implicit TLS).
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="StudyFlow <no-reply@studyflow.dev>"

# -----------------------------------------------------------------------
# Application Base URL
# -----------------------------------------------------------------------
# Used for constructing absolute URLs (e.g. password reset links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"